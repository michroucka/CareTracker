# Database
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=caretracker

# Email Configuration (add to backend secrets.properties)
# For Gmail: Use App Password (not regular password)
# Generate at: https://myaccount.google.com/apppasswords
spring.mail.username=your_email@gmail.com
spring.mail.password=your_app_password

# Mapy.com API key (add to backend secrets.properties)
# Generate at: https://developer.mapy.com
app.mapy.api-key=your_mapy_api_key

# Remember-me key (add to backend secrets.properties)
# Generate with: openssl rand -base64 32
app.remember-me.key=your_remember_me_key
